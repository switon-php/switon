{
  "name": "arcus/arcus",
  "description": "Application skeleton for Switon Framework",
  "keywords": ["switon", "arcus", "framework"],
  "homepage": "https://example.com/arcus",
  "authors": [
    { "name": "Arcus", "email": "arcus@example.com" }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "../packages/core/helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "psr/container": "2.0.2",
    "psr/log": "2.0.0",
    "psr/simple-cache": "^3.0",
    "psr/event-dispatcher": "1.0.*",
    "switon/authz": "^1.0",
    "switon/cache": "^1.0",
    "switon/context": "^1.0",
    "switon/cli": "^1.0",
    "switon/core": "^1.0",
    "switon/event": "^1.0",
    "switon/http": "^1.0",
    "switon/id": "^1.0",
    "switon/kernel": "^1.0",
    "switon/composer-extra-plugin": "^1.0",
    "switon/log": "^1.0",
    "switon/principal": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "switon/beacon": "^1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../packages/*",
      "options": { "symlink": true }
    }
  ],
  "config": {
    "preferred-install": { "*": "symlink" },
    "allow-plugins": { "switon/composer-extra-plugin": true }
  }
}
