{
  "name": "switon/tutorial-mainline-app",
  "description": "Runnable proof app for the Switon English tutorial mainline",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "switon",
      "email": "admin@switon.dev"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "psr/container": "2.0.2",
    "psr/event-dispatcher": "1.0.*",
    "psr/log": "2.0.0",
    "psr/simple-cache": "^3.0",
    "switon/authz": "^1.0",
    "switon/cache": "^1.0",
    "switon/cli": "^1.0",
    "switon/composer-extra-plugin": "^1.0",
    "switon/context": "^1.0",
    "switon/core": "^1.0",
    "switon/db": "^1.0",
    "switon/di": "^1.0",
    "switon/event": "^1.0",
    "switon/http": "^1.0",
    "switon/id": "^1.0",
    "switon/kernel": "^1.0",
    "switon/log": "^1.0",
    "switon/orm": "^1.0",
    "switon/validation": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "../../../packages/core/helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../../../packages/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "preferred-install": {
      "*": "symlink"
    },
    "allow-plugins": {
      "switon/composer-plugin": false,
      "switon/composer-extra-plugin": true
    }
  }
}
