APP_ENV=dev
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
SERVER_HOST=0.0.0.0
SERVER_TYPE=php
SERVER_PORT=9520
LOG_LEVEL=debug

# Absolute path for @books; omit to use @runtime/books (do not set empty)
# BOOKS_ROOT=/abs/path/to/books

# HMAC hex key for JWT (64 hex chars = 32 bytes for HS256)
DOCFS_JWT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Cipher master secret (Jwt autowires Cipher even with static JWT key)
MASTER_KEY=dev
