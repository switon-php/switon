{
    "name": "switon/app-docfs",
    "description": "Open-source Switon sample for docfs \u2014 Git-native docs via MCP tools; no database",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "psr/container": "2.0.2",
        "psr/log": "2.0.0",
        "psr/simple-cache": "^3.0",
        "psr/event-dispatcher": "1.0.*",
        "switon/authz": "^1.0",
        "switon/cli": "^1.0",
        "switon/composer-extra": "^1.0",
        "switon/context": "^1.0",
        "switon/core": "^1.0",
        "switon/event": "^1.0",
        "switon/http": "^1.0",
        "switon/i18n": "^1.0",
        "switon/id": "^1.0",
        "switon/jwt": "^1.0",
        "switon/kernel": "^1.0",
        "switon/log": "^1.0",
        "switon/mcp": "@dev",
        "switon/principal": "^1.0",
        "switon/validation": "^1.0",
        "switon/yaml": "^1.0"
    },
    "require-dev": {
        "switon/testing": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "preferred-install": {
            "*": "symlink"
        },
        "allow-plugins": {
            "switon/composer-extra": true
        }
    },
    "extra": {
        "switon": {
            "version": "0.1.0"
        }
    }
}
