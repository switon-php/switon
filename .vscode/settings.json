{
    "php.version": "8.3",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.git/logs/**": true,
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/runtime/**": true,
        "**/@runtime/**": true,
        "**/cache/**": true,
        "**/.cache/**": true,
        "**/.phpstan.cache/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/coverage/**": true,
        "**/.vitepress/cache/**": true,
        "**/.vitepress/dist/**": true,
        "**/.vitepress/.temp/**": true,
        "**/.venv*/**": true,
        "**/docs/**": true,
        "**/arcus/**": true,
        "**/app-admin/**": true
    },
    "search.exclude": {
        "**/vendor": true,
        "**/node_modules": true,
        "**/runtime": true,
        "**/@runtime": true,
        "**/cache": true,
        "**/.cache": true,
        "**/build": true,
        "**/dist": true,
        "**/coverage": true,
        "**/.venv*": true,
        "**/docs": true,
        "**/arcus": true,
        "**/app-admin/vendor": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/runtime": true,
        "**/@runtime": true,
        "**/coverage": true
    },
    "search.followSymlinks": false,
    "git.autorefresh": false
}
