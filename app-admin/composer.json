{
  "name": "switon/app-admin",
  "description": "Admin application template for Switon Framework",
  "type": "project",
  "keywords": [
    "switon",
    "admin",
    "dashboard",
    "rbac",
    "template"
  ],
  "homepage": "https://github.com/switon-php/app-admin",
  "license": "MIT",
  "authors": [
    {
      "name": "switon",
      "email": "admin@switon.dev"
    }
  ],
  "support": {
    "source": "https://github.com/switon-php/app-admin",
    "issues": "https://github.com/switon-php/app-admin/issues"
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "psr/container": "2.0.2",
    "psr/log": "2.0.0",
    "psr/simple-cache": "^3.0",
    "psr/event-dispatcher": "1.0.*",
    "switon/authz": "^1.0",
    "switon/cache": "^1.0",
    "switon/context": "^1.0",
    "switon/core": "^1.0",
    "switon/event": "^1.0",
    "switon/http": "^1.0",
    "switon/i18n": "^1.0",
    "switon/id": "^1.0",
    "switon/inspector": "^1.0",
    "switon/kernel": "^1.0",
    "switon/log": "^1.0",
    "switon/openapi": "^1.0",
    "switon/cli": "^1.0",
    "switon/db": "^1.0",
    "switon/dict": "^1.0",
    "switon/session": "^1.0",
    "switon/view": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "switon/beacon": "^1.0",
    "switon/composer-extra-plugin": "^1.0",
    "switon/orm-codegen": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "../tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../packages/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "preferred-install": {
      "*": "symlink"
    },
    "allow-plugins": {
      "switon/composer-extra-plugin": true
    }
  },
  "extra": {
    "switon": {
      "version": "0.0.0"
    }
  }
}
