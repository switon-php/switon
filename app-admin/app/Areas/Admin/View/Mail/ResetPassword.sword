<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title></title>
</head>
<body>
<div class="email">
    <div class="email-con" style="width: 700px; font-size: 14px;">
        <div class="email-con-main" style="padding: 25px 0 0 5px;">
            <p>{{t('mail.reset_password.greeting')}}<span style="color: #0f7b6d;"> {{$admin_name}}</span></p>
            <div style="padding:1px 0 0 50px;width: 600px;">
                <p>{{t('mail.reset_password.requested')}}</p>
                <a href="{{action(['/admin/password/reset','token'=>$token], true)}}"
                   style="display: block; color: #159887;text-decoration: none;">{{t('mail.reset_password.link_text')}}</a>
                <p>{{t('mail.reset_password.fallback')}}<a
                            href="{{action('/admin/password/forget',true)}}"
                            style="color: #159887;text-decoration: none;">{{t('mail.reset_password.retry_link')}}</a>
                </p>
                <a href="{{action(['/admin/password/reset','token'=>$token], true)}}"
                   style="color: #159887;text-decoration: none; word-wrap: break-word;">{{action(['/admin/password/reset','token'=>$token], true)}}</a>
                <p>{{t('mail.reset_password.email_label')}}<span style="color: #159887;">{{$email}}</span></p>
                <p>{{t('mail.reset_password.email_safe')}}</p>
                <p style="color: #C6C6C6;">{{t('mail.reset_password.no_reply')}}</p>
            </div>
        </div>
    </div>
</div>
</body>
</html>
