    <m-text prop="group_name" label="{{t('menu.group_name')}}"></m-text>
    <m-text prop="icon" width="130" show-overflow-tooltip></m-text>
    <m-account prop="updated_by"></m-account>
    <m-timestamp prop="updated_at"></m-timestamp>
    <m-account prop="created_by"></m-account>
    <m-timestamp prop="created_at"></m-timestamp>
    <m-actions actions="edit,delete"></m-actions>
</m-table>
