    <script>(function () {
            var k = 'switon.admin.theme', L = {
                switon: 'light',
                beacon: 'light',
                forest: 'light',
                ocean: 'light',
                ember: 'light',
                lilac: 'light',
                slate: 'light',
                crimson: 'light',
                azure: 'light',
                coral: 'light',
                mint: 'light',
                midnight: 'light',
                gold: 'light',
                rose: 'light',
                copper: 'light',
                frost: 'light',
                lagoon: 'light',
                cherry: 'light',
                graphite: 'light',
                moss: 'light',
                plum: 'light',
                mui: 'light',
                semi: 'light',
                naive: 'light',
                linear: 'light',
                notion: 'light',
                chakra: 'light',
                tailwind: 'light',
                vercel: 'light',
                dracula: 'dark',
                antd: 'light',
                arco: 'light',
                bootstrap: 'light',
                carbon: 'light',
                element: 'light',
                fluent: 'light',
                github: 'light',
                radix: 'light',
                shadcn: 'light',
                stripe: 'light'
            }, a = ['light', 'dark'], t = localStorage.getItem(k);
            if (t && L[t]) {
                localStorage.setItem(k, L[t]);
                t = L[t];
            }
            t = t && a.indexOf(t) >= 0 ? t : 'light';
            document.documentElement.setAttribute('data-admin-theme', t);
        })();</script>
