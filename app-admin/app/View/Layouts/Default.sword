<script>
    // Initialize inspector links for the current page BEFORE Vue component mounts
    @if(isset($inspector) && $inspector)
        window.inspectorLinkCounter = 1;
    window.lastRequestTime = Date.now();
    window.currentBatchId = 1;
    window.inspectorLinks = [{
        url: '{{$inspector}}',
        requestUrl: window.location.href,
        method: 'GET',
        index: 1,
        timestamp: Date.now(),
        batchId: 1
    }];
    @else
        window.inspectorLinks = window.inspectorLinks || [];
    window.inspectorLinkCounter = window.inspectorLinkCounter || 0;
    window.lastRequestTime = window.lastRequestTime || 0;
    window.currentBatchId = window.currentBatchId || 0;
    @endif
</script>
@yield('script')
<script>
    if (typeof vm === 'undefined') {
        vm = new App();
    }
    Vue.prototype.BASE_URL = window.BASE_URL;
    bootAdminShell(vm);
</script>
