{
  "name": "switon/skill",
  "description": "SKILL.md catalog, lookup, and path reload for Switon Framework",
  "type": "library",
  "keywords": [
    "switon",
    "skill",
    "catalog",
    "ai"
  ],
  "homepage": "https://github.com/switon-php/skill",
  "license": "MIT",
  "authors": [
    {
      "name": "switon",
      "email": "admin@switon.dev"
    }
  ],
  "support": {
    "source": "https://github.com/switon-php/skill",
    "issues": "https://github.com/switon-php/skill/issues",
    "docs": "https://github.com/switon-php/skill/blob/main/docs/README.md"
  },
  "require": {
    "php": ">=8.3",
    "ext-mbstring": "*",
    "switon/ai": "^1.0",
    "switon/core": "^1.0",
    "switon/tooling": "^1.0",
    "switon/yaml": "^1.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "switon/testing": "^1.0",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "switon/composer-extra": true,
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Switon\\Skill\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Switon\\Skill\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "@php vendor/bin/phpstan analyse",
    "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
    "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
  },
  "extra": {
    "switon": {
      "providers": [
        "Switon\\Skill\\ServiceProvider"
      ],
      "commands": [
        "Switon\\Skill\\Command\\SkillCommand"
      ],
      "tools": {
        "skill_list": "Switon\\Skill\\Tool\\SkillListTool",
        "skill_load": "Switon\\Skill\\Tool\\SkillLoadTool",
        "skill_run": "Switon\\Skill\\Tool\\SkillRunTool"
      },
      "agent": {
        "extensions": [
          "Switon\\Skill\\SkillLinkExtension"
        ]
      },
      "prompt": {
        "variables": [
          "Switon\\Skill\\SkillsInterface"
        ]
      }
    },
    "branch-alias": {
      "dev-dev": "1.0.x-dev"
    }
  }
}
