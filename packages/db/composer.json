{
    "name": "switon/db",
    "description": "Direct SQL client with named binds, transient transactions, and optional read or write routing for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "database",
        "sql",
        "pdo",
        "transactions"
    ],
    "homepage": "https://github.com/switon-php/db",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/db",
        "issues": "https://github.com/switon-php/db/issues",
        "docs": "https://docs.switon.dev/latest/db"
    },
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "switon/command": "^1.0",
        "switon/core": "^1.0",
        "switon/di": "^1.0",
        "switon/event": "^1.0",
        "switon/pool": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Db\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Db\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "commands": [
                "Switon\\Db\\Command\\DbCommand"
            ],
            "collectors": {
                "sql": "Switon\\Db\\Inspector\\SqlCollector"
            }
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
