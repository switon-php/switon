{
    "name": "switon/ai",
    "description": "Stable AI contracts for Switon Framework (shared primitives; not providers or agent loop)",
    "type": "library",
    "keywords": [
        "switon",
        "ai",
        "contracts",
        "memory"
    ],
    "homepage": "https://github.com/switon-php/ai",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/ai",
        "issues": "https://github.com/switon-php/ai/issues",
        "docs": "https://github.com/switon-php/ai/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "psr/container": "^2.0",
        "switon/core": "^1.0",
        "switon/event": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Ai\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
