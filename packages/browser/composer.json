{
  "name": "switon/browser",
  "description": "Headed agent tab for Switon: snapshot refs, then click and type on that page",
  "type": "library",
  "keywords": [
    "switon",
    "browser",
    "chrome",
    "cdp",
    "devtools"
  ],
  "homepage": "https://github.com/switon-php/browser",
  "license": "MIT",
  "authors": [
    {
      "name": "switon",
      "email": "admin@switon.dev"
    }
  ],
  "support": {
    "source": "https://github.com/switon-php/browser",
    "issues": "https://github.com/switon-php/browser/issues",
    "docs": "https://github.com/switon-php/browser/blob/main/docs/README.md"
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "switon/cdp": "^1.0",
    "switon/ai": "^1.0",
    "switon/core": "^1.0",
    "switon/tooling": "^1.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "switon/testing": "^1.0",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "switon/composer-extra": true,
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Switon\\Browser\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Switon\\Browser\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "@php vendor/bin/phpstan analyse",
    "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
    "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
  },
  "extra": {
    "switon": {
      "providers": [
        "Switon\\Browser\\ServiceProvider"
      ],
      "tools": {
        "browser_navigate": "Switon\\Browser\\Tool\\BrowserNavigateTool",
        "browser_close": "Switon\\Browser\\Tool\\BrowserCloseTool",
        "browser_snapshot": "Switon\\Browser\\Tool\\BrowserSnapshotTool",
        "browser_click": "Switon\\Browser\\Tool\\BrowserClickTool",
        "browser_type": "Switon\\Browser\\Tool\\BrowserTypeTool",
        "browser_take_screenshot": "Switon\\Browser\\Tool\\BrowserTakeScreenshotTool",
        "browser_console": "Switon\\Browser\\Tool\\BrowserConsoleTool",
        "browser_inspect": "Switon\\Browser\\Tool\\BrowserInspectTool",
        "browser_scroll": "Switon\\Browser\\Tool\\BrowserScrollTool",
        "browser_assert": "Switon\\Browser\\Tool\\BrowserAssertTool"
      }
    },
    "branch-alias": {
      "dev-dev": "1.0.x-dev"
    }
  }
}
