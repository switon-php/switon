{
    "name": "switon/context",
    "description": "Default context manager for request- and coroutine-scoped service-owned state for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "context",
        "scope",
        "runtime"
    ],
    "homepage": "https://github.com/switon-php/context",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/context",
        "issues": "https://github.com/switon-php/context/issues",
        "docs": "https://github.com/switon-php/context/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "psr/event-dispatcher": "^1.0",
        "switon/core": "^1.0",
        "switon/event": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Context\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Context\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": [
                "Switon\\Context\\ServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
