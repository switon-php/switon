{
    "name": "switon/jwt",
    "description": "HMAC JWT issue, validation, and optional kid-based key routing for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "jwt",
        "tokens",
        "authentication"
    ],
    "homepage": "https://github.com/switon-php/jwt",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/jwt",
        "issues": "https://github.com/switon-php/jwt/issues",
        "docs": "https://docs.switon.dev/latest/jwt"
    },
    "require": {
        "php": ">=8.3",
        "switon/crypto": "^1.0",
        "switon/core": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Jwt\\": "src/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Jwt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
