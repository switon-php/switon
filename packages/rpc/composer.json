{
    "name": "switon/rpc",
    "description": "Queue-backed synchronous request-reply calls between PHP handlers for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "rpc",
        "queue",
        "messaging"
    ],
    "homepage": "https://github.com/switon-php/rpc",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/rpc",
        "issues": "https://github.com/switon-php/rpc/issues",
        "docs": "https://docs.switon.dev/latest/rpc"
    },
    "require": {
        "php": ">=8.3",
        "switon/core": "^1.0",
        "switon/event": "^1.0",
        "switon/executor": "^1.0",
        "switon/invoker": "^1.0",
        "switon/queue": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Rpc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Rpc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "commands": [
                "Switon\\Rpc\\Command\\RpcCommand"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
