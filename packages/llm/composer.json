{
    "name": "switon/llm",
    "description": "OpenAI-compatible LLM chat client for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "llm",
        "openai",
        "chat",
        "ai"
    ],
    "homepage": "https://github.com/switon-php/llm",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/llm",
        "issues": "https://github.com/switon-php/llm/issues",
        "docs": "https://github.com/switon-php/llm/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "psr/event-dispatcher": "^1.0",
        "switon/composer-extra": "^1.0",
        "switon/ai": "^1.0",
        "switon/core": "^1.0",
        "switon/di": "^1.0",
        "switon/event": "^1.0",
        "switon/yaml": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Llm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Llm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": [
                "Switon\\Llm\\ServiceProvider"
            ],
            "commands": [
                "Switon\\Llm\\Command\\LlmCommand"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
