{
    "name": "switon/lint",
    "description": "Extension-routed single-file lint drivers and structured diagnostics for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "lint",
        "diagnostics",
        "phpstan",
        "static-analysis"
    ],
    "homepage": "https://github.com/switon-php/lint",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/lint",
        "issues": "https://github.com/switon-php/lint/issues",
        "docs": "https://github.com/switon-php/lint/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "switon/core": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Lint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Lint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
