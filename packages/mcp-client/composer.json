{
  "name": "switon/mcp-client",
  "description": "Model Context Protocol client: transports, server catalog, and mcp_servers, mcp_tools, mcp_schema, mcp_call for Switon Framework",
  "type": "library",
  "keywords": [
    "switon",
    "mcp",
    "mcp-client",
    "model-context-protocol",
    "json-rpc"
  ],
  "homepage": "https://github.com/switon-php/mcp-client",
  "license": "MIT",
  "authors": [
    {
      "name": "switon",
      "email": "admin@switon.dev"
    }
  ],
  "support": {
    "source": "https://github.com/switon-php/mcp-client",
    "issues": "https://github.com/switon-php/mcp-client/issues",
    "docs": "https://github.com/switon-php/mcp-client/blob/main/docs/README.md"
  },
  "require": {
    "php": ">=8.3",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^2.0",
    "switon/ai": "^1.0",
    "switon/composer-extra": "^1.0",
    "switon/core": "^1.0",
    "switon/di": "^1.0",
    "switon/event": "^1.0",
    "switon/http-client": "^1.0",
    "switon/tooling": "^1.0",
    "switon/yaml": "^1.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "switon/mcp": "^1.0",
    "switon/testing": "^1.0",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Switon\\McpClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Switon\\McpClient\\Tests\\": "tests/"
    }
  },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
  "extra": {
    "switon": {
      "providers": [
        "Switon\\McpClient\\ServiceProvider"
      ],
      "commands": [
        "Switon\\McpClient\\Command\\McpClientCommand"
      ],
      "tools": {
        "mcp_servers": "Switon\\McpClient\\Tool\\McpServersTool",
        "mcp_tools": "Switon\\McpClient\\Tool\\McpToolsTool",
        "mcp_schema": "Switon\\McpClient\\Tool\\McpSchemaTool",
        "mcp_call": "Switon\\McpClient\\Tool\\McpCallTool"
      },
      "mcp": {
        "importers": {
          "~/.cursor/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.claude.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/Library/Application Support/Claude/claude_desktop_config.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.config/Claude/claude_desktop_config.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/Library/Application Support/Code/User/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/Library/Application Support/Code - Insiders/User/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.config/Code/User/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.config/Code - Insiders/User/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.qoder/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.qoder/settings.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.codebuddy/.mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.codebuddy/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.trae/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.gemini/settings.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.copilot/mcp-config.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.codeium/windsurf/mcp_config.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.config/devin/mcp_config.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.lmstudio/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.cline/data/settings/cline_mcp_settings.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/Library/Application Support/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.aws/amazonq/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.kiro/settings/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.amp/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.augment/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.lingma/extension/local/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.lingma/lingma_mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.codegeex/agent/configs/mcp_config.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.codegeex/agent/configs/user_mcp_config.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.workbuddy-ai/connectors/default/mcp.json": "Switon\\McpClient\\Importer\\McpServersJsonImporter",
          "~/.codex/config.toml": "Switon\\McpClient\\Importer\\CodexTomlImporter"
        }
      }
    },
    "branch-alias": {
      "dev-dev": "1.0.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "switon/composer-extra": true,
      "phpstan/extension-installer": true
    }
  }
}
