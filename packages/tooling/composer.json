{
    "name": "switon/tooling",
    "description": "Named file, search, and shell tools for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "tooling",
        "file",
        "shell",
        "search"
    ],
    "homepage": "https://github.com/switon-php/tooling",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/tooling",
        "issues": "https://github.com/switon-php/tooling/issues",
        "docs": "https://github.com/switon-php/tooling/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "switon/composer-extra": "^1.0",
        "switon/ai": "^1.0",
        "switon/core": "^1.0",
        "switon/event": "^1.0",
        "switon/lint": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Tooling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Tooling\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": [
                "Switon\\Tooling\\ServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
