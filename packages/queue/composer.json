{
    "name": "switon/queue",
    "description": "Redis-backed job queue with runner discovery and worker commands for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "queue",
        "jobs",
        "redis"
    ],
    "homepage": "https://github.com/switon-php/queue",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/queue",
        "issues": "https://github.com/switon-php/queue/issues",
        "docs": "https://docs.switon.dev/latest/queue"
    },
    "require": {
        "php": ">=8.3",
        "psr/event-dispatcher": "^1.0",
        "switon/composer-extra": "^1.0",
        "switon/core": "^1.0",
        "switon/event": "^1.0",
        "switon/executor": "^1.0",
        "switon/redis": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Switon\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Queue\\Tests\\": "tests/",
            "Switon\\Queue\\Tests\\Fixtures\\": "tests/Fixtures/"
        }
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "commands": [
                "Switon\\Queue\\Command\\QueueCommand"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
