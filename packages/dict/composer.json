{
    "name": "switon/dict",
    "description": "Controlled value-set types for actions, validated inputs, and shared option rows for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "dictionary",
        "valuesets",
        "validation"
    ],
    "homepage": "https://github.com/switon-php/dict",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/dict",
        "issues": "https://github.com/switon-php/dict/issues",
        "docs": "https://docs.switon.dev/latest/dict"
    },
    "require": {
        "php": ">=8.3",
        "switon/binding": "^1.0",
        "switon/core": "^1.0",
        "switon/validation": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Dict\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Dict\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/App/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": [
                "Switon\\Dict\\ServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
