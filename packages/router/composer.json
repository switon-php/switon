{
    "name": "switon/router",
    "description": "Attribute-discovered routes, route tables, and literal and dynamic path matching for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "router",
        "routing",
        "paths"
    ],
    "homepage": "https://github.com/switon-php/router",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/router",
        "issues": "https://github.com/switon-php/router/issues",
        "docs": "https://github.com/switon-php/router/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "psr/event-dispatcher": "^1.0",
        "switon/command": "^1.0",
        "switon/console": "^1.0",
        "switon/core": "^1.0",
        "switon/event": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Routing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "commands": [
                "Switon\\Routing\\Command\\RouterCommand"
            ],
            "collectors": {
                "router": "Switon\\Routing\\Inspector\\RouterCollector"
            }
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
